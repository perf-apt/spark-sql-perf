# Copy to bench.env and edit. The only things that change between local and GCP are these values.

# ── Spark distributions ───────────────────────────────────────────────────────
STOCK_SPARK_HOME=/opt/oss/spark-4.1.1-bin-hadoop3
TABBY_SPARK_HOME=/opt/tabbydb/tabbydb-4.1.1-bin-tabbydb
MASTER=spark://Asifs-Mac-mini.local:7077

# ── Jars ──────────────────────────────────────────────────────────────────────
PERF_JAR=/Users/ashahid/workspace/tpcds-benchmark/spark-sql-perf/target/scala-2.13/spark-sql-perf_2.13-0.5.1-SNAPSHOT.jar
ICEBERG_JAR_STOCK="/path/to/iceberg-spark-runtime-4.1_2.13-VERSION.jar"
ICEBERG_JAR_TABBY=/Users/ashahid/workspace/perf-apt/kwikquery-iceberg/tabbydb/v4.1/spark-runtime/build/libs/iceberg-tabbydb-runtime-4.1.1_2.13-1.11.0-SNAPSHOT.jar
# GCP only: GCS connector, e.g. gcs-connector-hadoop3-latest.jar (or drop it into both $SPARK_HOME/jars)
EXTRA_JARS=

# ── Common Spark settings (BOTH engines) ─────────────────────────────────────
# Base layer, shared by stock Spark and TabbyDB (moved here from both conf/ folders).
# Precedence, lowest -> highest:
#   COMMON_SPARK_ENV / COMMON_SPARK_PROPS (here)
#   < the engine's own $SPARK_HOME/conf/spark-env.sh and spark-defaults.conf  (per-engine overrides)
#   < COMMON_CONF / EXTRA_SPARK_CONF below (command line)
# run-all.sh merges the first two into $LOG_DIR/generated-conf/<engine>/ for master, workers and spark-shell.
# One NAME=value / key=value per line.
COMMON_SPARK_ENV="
SPARK_LOCAL_DIRS=/Users/ashahid/workspace/spark_scratch
SPARK_WORKER_INSTANCES=1
SPARK_DRIVER_MEMORY=1G
SPARK_WORKER_MEMORY=12G
SPARK_WORKER_CORES=8
SPARK_EXECUTOR_CORES=4
SPARK_EXECUTOR_MEMORY=5g
SPARK_SHUFFLE_SERVICE_ENABLED=true
SPARK_SHUFFLE_SERVICE_PORT=7337
"
COMMON_SPARK_PROPS="
spark.sql.autoBroadcastJoinThresholdInnerJoin=10MB
spark.sql.adaptive.maxShuffledHashJoinLocalMapThreshold=5MB
spark.driver.maxResultSize=1024MB
spark.sql.catalogImplementation=hive
spark.sql.execution.broadcastHashJoin.useAggsNonTrivialFiltersToSelectBHJStrategy=true
spark.sql.execution.broadcastHashJoin.considerPushedBroadcastVarOnBatchScanAsPrunablity=true
spark.sql.execution.broadcastHashJoin.useBroadcastAsFilterOnSubqueries=true
spark.sql.execution.broadcastHashJoin.preferReuseExchangeOverBroadcastVarPushdown=false
spark.sql.execution.broadcastHashJoin.pushKeysAsFilterToScan=true
spark.sql.execution.broadcastHashJoin.groupBroadcastVarsOfSameColumnUseMinOnly=true
spark.sql.execution.broadcastHashJoin.useBroadcastVarsInColumnToRowExec=true
spark.sql.execution.bhj.descendJoinToCheckBuildPrunabilityForBCVar=false
spark.sql.execution.broadcastHashJoin.createTreesetForFocusIndex=true
spark.driver.memoryOverhead=1g
spark.executor.memoryOverhead=1g
spark.sql.join.preferSortMergeJoin=false
"
# Optional: replace each engine's own conf/ folder (layer 2) with this folder. Normally leave empty.
COMMON_SPARK_CONF_DIR=

# Standalone only (MASTER=spark://...): executors run from the installation that started the workers,
# so the master + workers are restarted from the engine's own SPARK_HOME whenever the engine changes.
MANAGE_CLUSTER=true
MASTER_WEBUI=http://localhost:8080

# Which distribution creates the Hive/Iceberg tables (metadata is engine-neutral)
TABLES_ENGINE=stock

# ── Data / metadata / results ─────────────────────────────────────────────────
SCALE=10
DSDGEN_DIR=/opt/tpcds/tpcds-kit/tools          # same path on every worker
GEN_PARTITIONS=100
DATA_DIR=file:///Users/ashahid/workspace/tpcds-benchmark/generated_data/sf${SCALE}
ICEBERG_WAREHOUSE=file:///Users/ashahid/workspace/tpcds-benchmark/iceberg_warehouse/sf${SCALE}   # must NOT be inside DATA_DIR
RESULT_DIR=file:///Users/ashahid/workspace/tpcds-benchmark/results
METASTORE_DIR=/Users/ashahid/workspace/tpcds-benchmark/metastore   # embedded Derby, shared by both engines
LOG_DIR=/Users/ashahid/workspace/tpcds-benchmark/logs

HIVE_DB=tpcds_hive
ICEBERG_DB=tpcds_ice
USE_DOUBLE_FOR_DECIMAL=true
ANALYZE_HIVE=true

# ── Benchmark ─────────────────────────────────────────────────────────────────
RUN_ID=sf${SCALE}-campaign1      # keep FIXED for a campaign: resume matches on RUN_ID
ITERATIONS=2
QUERY_TIMEOUT_SEC=7200
# Benchmark refuses to start until at least this many executors have registered (spark:// masters only).
# With COMMON_SPARK_ENV above: 1 worker (8 cores, 12G) / executor (4 cores, 5g) => 2 executors.
MIN_EXECUTORS=2
QUERIES=                                   # empty = all; e.g. q1-v2.4,q72-v2.4 for a quick test

# Command-line overrides for BOTH engines — WIN over everything above (incl. per-engine conf/).
# Resources normally come from COMMON_SPARK_ENV; keep empty unless you need to override.
COMMON_CONF=""
# Extra settings applied to both engines, e.g. TabbyDB flags you want on in both (stock ignores unknown ones)
EXTRA_SPARK_CONF=""

# Command run before every benchmark invocation to drop OS page caches.
#   Linux single node : sync; echo 3 | sudo tee /proc/sys/vm/drop_caches >/dev/null
#   GCP 2 nodes       : for h in tpcds-node1 tpcds-node2; do ssh $h 'sync; echo 3 | sudo tee /proc/sys/vm/drop_caches >/dev/null'; done
#   macOS             : sudo purge
DROP_CACHES_CMD=""
